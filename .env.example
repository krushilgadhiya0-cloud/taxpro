# TaxPro AI & Server Configuration
PORT=5000

# Google Gemini API Key (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative LLM Keys (OpenAI / Groq)
OPENAI_API_KEY=
GROQ_API_KEY=

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taxpro

# Email / SMTP Configuration
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
